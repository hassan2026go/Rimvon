# انسخ هذا الملف باسم keystore.properties (لا ترفعه لأي مكان) بعد إنشاء مفتاح التوقيع:
#   keytool -genkeypair -v -keystore rimvon-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias rimvon
storeFile=rimvon-release.jks
storePassword=PUT_PASSWORD_HERE
keyAlias=rimvon
keyPassword=PUT_PASSWORD_HERE
